From 807da0b709d5086b81e2155713daaf49e4aefd0d Mon Sep 17 00:00:00 2001
From: huangzuo <huangzuo@gmail.com>
Date: Thu, 20 Aug 2026 21:53:06 +1000
Subject: [PATCH] hwmon: applesmc: expose full ambient light sensor data

---
 .../ABI/testing/sysfs-platform-applesmc       | 17 ++++++
 drivers/hwmon/applesmc.c                      | 60 +++++++++++++++++++
 2 files changed, 77 insertions(+)
 create mode 100644 Documentation/ABI/testing/sysfs-platform-applesmc

diff --git a/Documentation/ABI/testing/sysfs-platform-applesmc b/Documentation/ABI/testing/sysfs-platform-applesmc
new file mode 100644
index 000000000..69853bcaa
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-platform-applesmc
@@ -0,0 +1,17 @@
+What:		/sys/devices/platform/applesmc.768/light_millilux
+Date:		August 2026
+Contact:	Linux hardware monitoring mailing list <linux-hwmon@vger.kernel.org>
+Description:
+		Room illuminance reported by a 10-byte Apple SMC ALV0 key,
+		converted from its unsigned FP18.14 representation to millilux.
+		This attribute is unavailable on machines with a different ALV0
+		format.
+
+What:		/sys/devices/platform/applesmc.768/light_raw
+Date:		August 2026
+Contact:	Linux hardware monitoring mailing list <linux-hwmon@vger.kernel.org>
+Description:
+		Decoded fields from a 10-byte Apple SMC ALV0 key. The five decimal
+		values are valid, high_gain, channel0, channel1, and the unscaled
+		FP18.14 room-illuminance value. This attribute is unavailable on
+		machines with a different ALV0 format.
diff --git a/drivers/hwmon/applesmc.c b/drivers/hwmon/applesmc.c
index 24f3e86d0..381df140f 100644
--- a/drivers/hwmon/applesmc.c
+++ b/drivers/hwmon/applesmc.c
@@ -33,6 +33,7 @@
 #include <linux/workqueue.h>
 #include <linux/err.h>
 #include <linux/bits.h>
+#include <linux/unaligned.h>
 
 /* data port used by Apple SMC */
 #define APPLESMC_DATA_PORT	0x300
@@ -808,6 +809,63 @@ out:
 	return sysfs_emit(sysfsbuf, "(%d,%d)\n", left, right);
 }
 
+/*
+ * Expose the complete 10-byte {alv payload without requiring callers to use
+ * the privileged, global key_at_index selector.  Values are, in order:
+ *
+ *   valid high_gain channel0 channel1 room_lux_fp18_14
+ */
+static ssize_t applesmc_light_raw_show(struct device *dev,
+				       struct device_attribute *attr,
+				       char *sysfsbuf)
+{
+	const struct applesmc_entry *entry;
+	u8 buffer[10];
+	int ret;
+
+	entry = applesmc_get_entry_by_key(LIGHT_SENSOR_LEFT_KEY);
+	if (IS_ERR(entry))
+		return PTR_ERR(entry);
+	if (entry->len != sizeof(buffer))
+		return -EOPNOTSUPP;
+
+	ret = applesmc_read_key(LIGHT_SENSOR_LEFT_KEY, buffer, sizeof(buffer));
+	if (ret)
+		return ret;
+
+	return sysfs_emit(sysfsbuf, "%u %u %u %u %u\n",
+			  buffer[0], buffer[1],
+			  get_unaligned_be16(buffer + 2),
+			  get_unaligned_be16(buffer + 4),
+			  get_unaligned_be32(buffer + 6));
+}
+
+/* Report the FP18.14 room illuminance with sub-lux precision. */
+static ssize_t applesmc_light_millilux_show(struct device *dev,
+					    struct device_attribute *attr,
+					    char *sysfsbuf)
+{
+	const struct applesmc_entry *entry;
+	u8 buffer[10];
+	u64 room_millilux;
+	int ret;
+
+	entry = applesmc_get_entry_by_key(LIGHT_SENSOR_LEFT_KEY);
+	if (IS_ERR(entry))
+		return PTR_ERR(entry);
+	if (entry->len != sizeof(buffer))
+		return -EOPNOTSUPP;
+
+	ret = applesmc_read_key(LIGHT_SENSOR_LEFT_KEY, buffer, sizeof(buffer));
+	if (ret)
+		return ret;
+
+	room_millilux = (u64)get_unaligned_be32(buffer + 6) * 1000;
+	room_millilux = DIV_ROUND_CLOSEST_ULL(room_millilux, 1U << 14);
+
+	return sysfs_emit(sysfsbuf, "%llu\n", room_millilux);
+}
+
 /* Displays sensor key as label */
 static ssize_t applesmc_show_sensor_label(struct device *dev,
 			struct device_attribute *devattr, char *sysfsbuf)
@@ -1091,6 +1149,8 @@ static struct applesmc_node_group accelerometer_group[] = {
 
 static struct applesmc_node_group light_sensor_group[] = {
 	{ "light", applesmc_light_show },
+	{ "light_raw", applesmc_light_raw_show },
+	{ "light_millilux", applesmc_light_millilux_show },
 	{ }
 };
 
-- 
