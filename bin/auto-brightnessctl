#!/usr/bin/env bash

set -euo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/auto-brightness"
readonly CONFIG_FILE="$CONFIG_DIR/config"
readonly STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$UID}/auto-brightness-state"
readonly LOW_LIGHT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/auto-brightness/kernel"
readonly SMC_LIGHT_RAW_PATH="/sys/devices/platform/applesmc.768/light_raw"
OFFSET_PERCENT=0
STEP_PERCENT=2
SAMPLE_COUNT=5

load_config() {
  if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi
  [[ "${OFFSET_PERCENT:-}" =~ ^-?[0-9]+$ ]] || OFFSET_PERCENT=0
  [[ "${STEP_PERCENT:-}" =~ ^[0-9]+$ ]] || STEP_PERCENT=2
  [[ "${SAMPLE_COUNT:-}" =~ ^[0-9]+$ ]] || SAMPLE_COUNT=5
}

write_config() {
  local temporary
  mkdir -p "$CONFIG_DIR"
  temporary=$(mktemp "$CONFIG_DIR/config.XXXXXX")
  {
    printf 'OFFSET_PERCENT=%d\n' "$OFFSET_PERCENT"
    printf 'STEP_PERCENT=%d\n' "$STEP_PERCENT"
    printf 'SAMPLE_COUNT=%d\n' "$SAMPLE_COUNT"
  } > "$temporary"
  mv "$temporary" "$CONFIG_FILE"
}

status_json() {
  local active=false lux=0 brightness=0 target=0 manual=false
  local low_light_available=false low_light_enabled=false low_light_active=false
  local LUX=0 BRIGHTNESS=0 TARGET=0 MANUAL_OVERRIDE=0
  local actual maximum
  load_config
  if [[ -r "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$STATE_FILE"
    lux=${LUX:-0}; brightness=${BRIGHTNESS:-0}; target=${TARGET:-0}
    [[ "${MANUAL_OVERRIDE:-0}" == 1 ]] && manual=true
  fi
  actual=$(brightnessctl get 2>/dev/null || printf '0')
  maximum=$(brightnessctl max 2>/dev/null || printf '100')
  if (( maximum > 0 )); then brightness=$(( (actual * 100 + maximum / 2) / maximum )); fi
  systemctl --user is-active --quiet auto-brightness.service && active=true
  if [[ -x "$LOW_LIGHT_DIR/install.sh" && -x "$LOW_LIGHT_DIR/uninstall.sh" ]] &&
     command -v pkexec >/dev/null; then
    low_light_available=true
  fi
  if [[ -e /etc/modprobe.d/applesmc-als.conf &&
        -e /etc/modules-load.d/applesmc-als.conf ]]; then
    low_light_enabled=true
  fi
  [[ -r "$SMC_LIGHT_RAW_PATH" ]] && low_light_active=true
  printf '{"enabled":%s,"lux":%d,"brightness":%d,"target":%d,"manualOverride":%s,"offset":%d,"speed":%d,"smoothing":%d,"lowLightAvailable":%s,"lowLightEnabled":%s,"lowLightActive":%s}\n' \
    "$active" "$lux" "$brightness" "$target" "$manual" "$OFFSET_PERCENT" "$STEP_PERCENT" "$SAMPLE_COUNT" \
    "$low_light_available" "$low_light_enabled" "$low_light_active"
}

set_low_light() {
  local action=${1:-} script
  case "$action" in
    enable) script="$LOW_LIGHT_DIR/install.sh" ;;
    disable) script="$LOW_LIGHT_DIR/uninstall.sh" ;;
    *) exit 2 ;;
  esac
  [[ -x "$script" ]] || {
    printf 'Low-light kernel support is not installed with the plugin. Re-run the plugin installer.\n' >&2
    exit 1
  }
  command -v pkexec >/dev/null || {
    printf 'pkexec is required to change low-light kernel support.\n' >&2
    exit 1
  }
  pkexec "$script"
}

set_value() {
  local name=${1:-} value=${2:-}
  load_config
  case "$name" in
    offset)
      [[ "$value" =~ ^-?[0-9]+$ ]] || exit 2
      (( value < -20 )) && value=-20; (( value > 20 )) && value=20
      OFFSET_PERCENT=$value ;;
    speed)
      [[ "$value" =~ ^[0-9]+$ ]] || exit 2
      (( value < 1 )) && value=1; (( value > 5 )) && value=5
      STEP_PERCENT=$value ;;
    smoothing)
      [[ "$value" =~ ^[0-9]+$ ]] || exit 2
      (( value < 1 )) && value=1; (( value > 10 )) && value=10
      SAMPLE_COUNT=$value ;;
    *) exit 2 ;;
  esac
  write_config
}

case "${1:-status}" in
  status) status_json ;;
  enable) systemctl --user enable --now auto-brightness.service ;;
  disable) systemctl --user disable --now auto-brightness.service ;;
  toggle)
    if systemctl --user is-active --quiet auto-brightness.service; then
      systemctl --user disable --now auto-brightness.service
    else
      systemctl --user enable --now auto-brightness.service
    fi ;;
  resume) systemctl --user restart auto-brightness.service ;;
  low-light) set_low_light "${2:-}" ;;
  set) set_value "${2:-}" "${3:-}" ;;
  preset)
    case "${2:-}" in
      dim) set_value offset -10 ;; balanced) set_value offset 0 ;; bright) set_value offset 10 ;; *) exit 2 ;;
    esac ;;
  *)
    printf 'Usage: auto-brightnessctl {status|enable|disable|toggle|resume|low-light <enable|disable>|set <offset|speed|smoothing> <value>|preset <dim|balanced|bright>}\n' >&2
    exit 2 ;;
esac
